{
  "name": "atlas-global-briefing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node build/run-vinext.mjs dev",
    "build": "node build/run-vinext.mjs build",
    "start": "node build/run-vinext.mjs start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:ui": "python tests/interactive-ui.py",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "5.20260711.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "type": "module"
}
