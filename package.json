{
  "name": "atlas-global-briefing",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node build/run-vinext.mjs dev",
    "build": "node build/run-vinext.mjs build",
    "start": "node build/run-vinext.mjs start",
    "test": "npm run audit:sources && npm run build && node --test tests/*.test.mjs",
    "test:ui": "python tests/interactive-ui.py",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit:policy": "node security/audit-policy.mjs",
    "audit:sources": "node security/dependency-source-policy.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.44.0",
    "@cloudflare/workers-types": "5.20260711.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.1.4",
    "wrangler": "4.110.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "fast-uri": "4.1.1",
    "minimatch": "10.2.5"
  },
  "type": "module"
}
